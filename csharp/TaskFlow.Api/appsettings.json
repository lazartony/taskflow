{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true,
        "IncludeScopes": false
      }
    }
  },

  "AllowedHosts": "*",

  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  }

  // Everything else comes from the environment, not from here — see
  // Config/AppConfig.cs and the repository-root .env.example. This file holds
  // only what the ASP.NET Core host itself reads before AppConfig runs.
  //
  // Note that LOG_LEVEL (env) overrides the Logging:LogLevel:Default above:
  // Program.cs calls SetMinimumLevel after configuration is bound, so the env
  // var stays the single source of truth across all five services.
}
