{
  "uid": "taskflow-database",
  "title": "TaskFlow — Database",
  "description": "Connection pool state, query duration by operation, acquisition timeouts and pending requests. Sourced from the application's db_client_* instruments, not from Postgres itself.",
  "tags": [
    "taskflow",
    "database",
    "postgres",
    "use"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "preload": false,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "iconColor": "rgba(0, 211, 255, 1)",
        "enable": true,
        "hide": true,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(http_server_request_duration_seconds_count, service_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_request_duration_seconds_count, service_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "allValue": ".*",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0,
        "skipUrlSync": false,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": false
        },
        "options": []
      }
    ]
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "Pool state, query duration and the two failure modes that matter: **queueing for a connection** and **timing out waiting for one**.\n\nEverything here comes from the application's own `db_client_*` instruments (§5.3), so it appears in Phase 2 and gets interesting in Phase 3. Server-side depth — `pg_stat_statements` top queries, index hit ratio, table bloat, lock waits, replication lag — is *not* on this dashboard, because nothing in the stack scrapes Postgres itself. Use `make psql` and the queries in `docs/database-schema.md`, or add a `postgres_exporter` to `docker-compose.observability.yml` and a scrape job to `observability/prometheus/prometheus.yml` as a Phase 3 exercise."
      },
      "transparent": false,
      "pluginVersion": "13.0.3",
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "row",
      "title": "Saturation — read this panel first",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Pending connection requests (now)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "showPercentChange": false,
        "percentChangeColorMode": "standard",
        "text": {
          "valueSize": 64
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(db_client_connection_pending_requests{service_name=~\"$service\"})",
          "range": true,
          "instant": false
        }
      ],
      "pluginVersion": "13.0.3",
      "description": "Requests queueing for a pool connection, across the selected services. Zero is the only healthy value. This number moves *before* latency does — by the time p95 rises, this has already been non-zero for a while.",
      "id": 3,
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Pending connection requests by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "barAlignment": 0,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed+area"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (service_name, pool_name) (db_client_connection_pending_requests{service_name=~\"$service\"})",
          "range": true,
          "instant": false,
          "legendFormat": "{{service_name}} / {{pool_name}}"
        }
      ],
      "pluginVersion": "13.0.3",
      "description": "Sustained > 0 for 5m fires `DBPoolSaturated` (ticket); > 20 for 2m fires `DBPoolExhausted` (page). Both live in `observability/prometheus/rules/operational.yaml`.\n\nThe fix is usually not a bigger pool. A pool of 10 against `max_connections=200` is deliberate: connections are expensive on the Postgres side, and a pool large enough to never queue just moves the queue into the database.",
      "id": 4,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 6,
        "y": 5
      }
    },
    {
