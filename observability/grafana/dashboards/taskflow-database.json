        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (service_name, pool_name) (rate(db_client_connection_timeouts_total{service_name=~\"$service\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{service_name}} / {{pool_name}}"
        }
      ],
      "pluginVersion": "13.0.3",
      "description": "Saturation that has turned into errors: the request waited DATABASE_ACQUIRE_TIMEOUT_MS (2000) and gave up. Any non-zero value here is user-visible as a 5xx.",
