          "expr": "100 * (1 - (\n  (\n    sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",http_response_status_code=~\"5..\"}[30d]))\n    /\n    sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[30d]))\n  ) / (1 - 0.99)\n))",
          "range": true,
