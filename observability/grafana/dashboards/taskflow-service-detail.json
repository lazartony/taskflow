{
  "uid": "taskflow-service-detail",
  "title": "TaskFlow — Service Detail",
  "description": "One implementation at a time: RED, DB pool utilisation and saturation, cache, runtime memory, GC, event-loop lag and the slowest routes. Select the service in the dropdown.",
  "tags": [
    "taskflow",
    "service",
    "red",
    "use"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "preload": false,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "iconColor": "rgba(0, 211, 255, 1)",
        "enable": true,
        "hide": true,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(http_server_request_duration_seconds_count, service_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_request_duration_seconds_count, service_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "allValue": ".*",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0,
        "skipUrlSync": false,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": false
        },
        "options": []
      }
    ]
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "Pick a service in the **Service** dropdown above. Every panel is scoped to it.\n\nRead it in this order when something is slow: **in-flight** rises → **DB pool pending** rises → **latency** rises. Saturation moves before latency does, which is why the pending-requests panel is the big red one. Panels are empty until Phase 2 — see `docs/learning-roadmap.md`."
      },
      "transparent": false,
      "pluginVersion": "13.0.3",
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "row",
      "title": "RED",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "panels": []
    },
