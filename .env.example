# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and adjust.  `make setup` does this and generates a JWT_SECRET.
# Every one of the five implementations reads THESE names — that uniformity is
# deliberate, and it is what makes the benchmark comparison fair.
# ─────────────────────────────────────────────────────────────────────────────

# ── Which languages are you working in? ───────────────────────
# Every API service sits behind a compose profile named after its language.
# This line decides which ones exist for `docker compose`, and every tool in
# scripts/ reads it too — check-phase, progress, status, benchmark.
#
# Working in one language? That is a supported path, not a compromise:
#   make languages LANGS=go          → just Go
#   make languages LANGS=go,rust     → two
#   make languages LANGS=all         → back to all five
#
# Nothing is deleted either way. The other language directories stay on disk.
COMPOSE_PROFILES=go,rust,python,csharp,typescript

# ── Database ──────────────────────────────────────────────────
# Host-side URL: this is what migrate.sh, seed.sh and "run it outside Docker"
# use. The services running under compose get the compose-internal
# postgres:5432 instead, from docker-compose.yml.
#
# Already running a Postgres on 5432? See "Getting unstuck" in README.md — the
# port appears in three places that must agree, and this is one of them.
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskflow_dev
DATABASE_POOL_SIZE=10
DATABASE_MIN_IDLE=2
DATABASE_ACQUIRE_TIMEOUT_MS=2000
DATABASE_MAX_LIFETIME=30m
DATABASE_STATEMENT_TIMEOUT=5s

# ── Server ────────────────────────────────────────────────────
PORT=8080
ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SHUTDOWN_GRACE_PERIOD=30s
# The delay nobody implements. Load balancers poll readiness every 2-10s;
# without it, traffic is still arriving when you stop accepting.
SHUTDOWN_PRESTOP_DELAY=5s
MAX_CONCURRENT_REQUESTS=200
MAX_BODY_BYTES=1048576
READ_HEADER_TIMEOUT=5s
REQUEST_TIMEOUT=20s

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-make-setup-generates-one
JWT_ISSUER=taskflow
JWT_AUDIENCE=taskflow-api
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
JWT_CLOCK_SKEW=60s
BCRYPT_COST=12

# ── Cache (Phase 4) ───────────────────────────────────────────
VALKEY_URL=redis://localhost:6379/0
VALKEY_POOL_SIZE=10
VALKEY_CONNECT_TIMEOUT_MS=1000
# Load-bearing. Without a timeout, a slow cache becomes a slow API and the
# cache turns into a SOURCE of latency. 200ms is ~40x a healthy p99.
VALKEY_COMMAND_TIMEOUT_MS=200
CACHE_ENABLED=true
CACHE_TTL_TASK_LIST=60
CACHE_TTL_TASK=300
CACHE_TTL_USER=300
CACHE_TTL_JITTER_PCT=20
CACHE_STAMPEDE_LOCK_TTL=5

# ── Rate limiting (Phase 4) ───────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_TASKS_PER_MIN=100
RATE_LIMIT_UPLOAD_PER_MIN=20
RATE_LIMIT_WS_CONCURRENT=5

# ── Events (Phase 6) ──────────────────────────────────────────
# The transport. `streams` uses the Valkey instance you already run for the
# cache; `kafka` is the optional §4.9 appendix. Everything below the transport
# line — the outbox, processed_events, audit_log — is identical either way,
# which is the point.
EVENTS_BACKEND=streams
EVENTS_STREAM_TASK=taskflow:dev:events:task
EVENTS_STREAM_ATTACHMENT=taskflow:dev:events:attachment
EVENTS_STREAM_USER=taskflow:dev:events:user
EVENTS_STREAM_DLQ=taskflow:dev:events:task:dlq
EVENTS_CONSUMER_GROUP=taskflow.notifications
# Must be UNIQUE per process: it names the consumer inside the group, and it is
# what XPENDING attributes stuck entries to. Two replicas sharing a name share a
# pending list, so neither can tell which of them died. Use the hostname/pod name.
EVENTS_CONSUMER_NAME=${HOSTNAME:-taskflow-1}
EVENTS_READ_COUNT=50
EVENTS_BLOCK_MS=5000
# XADD ... MAXLEN ~ N. Streams are memory-bound, not disk-bound: without a cap
# this key grows until it hits maxmemory. `~` (approximate) trims on whole radix
# nodes, which is O(1)-ish; an exact MAXLEN walks the tree on every write.
EVENTS_MAXLEN=100000
EVENTS_MAXLEN_APPROXIMATE=true
# XAUTOCLAIM: how long an entry may sit unacknowledged in another consumer's
# pending list before a live consumer may steal it. Set it comfortably above
# your slowest legitimate processing time or healthy consumers rob each other.
EVENTS_CLAIM_MIN_IDLE_MS=60000
EVENTS_CLAIM_INTERVAL_MS=15000
# Deliveries of one entry before it goes to the DLQ (XPENDING reports the count).
EVENTS_MAX_DELIVERIES=3
OUTBOX_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10

# ── Events: Kafka appendix only (§4.9) ────────────────────────
# Ignored unless EVENTS_BACKEND=kafka. Redpanda does not start with the default
# compose stack — bring it up with `--profile kafka` first.
KAFKA_BROKERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_TOPIC_TASK_EVENTS=taskflow.task-events
KAFKA_CONSUMER_GROUP=taskflow.notifications
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_MAX_POLL_RECORDS=100
KAFKA_SESSION_TIMEOUT_MS=45000

# ── Object storage (running from day one) ─────────────────────
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=taskflow-attachments
S3_ACCESS_KEY=taskflow
S3_SECRET_KEY=taskflow-dev-secret
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_SECONDS=900
MAX_FILE_SIZE=10485760

# ── Observability (Phase 2) ───────────────────────────────────
OTEL_SERVICE_NAME=taskflow-go
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_TIMEOUT=10000
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.namespace=taskflow
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_SDK_DISABLED=false
LOG_LEVEL=info
LOG_FORMAT=json

# ── Profiling (Phase 8) ───────────────────────────────────────
PROFILING_ENABLED=false
PYROSCOPE_SERVER_ADDRESS=http://localhost:4040
GO_PPROF_PORT=6060
NODE_INSPECT_PORT=9229

# ── Resilience (Phase 5) ──────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=100
RETRY_MAX_DELAY_MS=5000
RETRY_BUDGET_RATIO=0.1
BREAKER_FAILURE_RATIO=0.5
BREAKER_MIN_REQUESTS=20
BREAKER_COOLDOWN_MS=5000
